<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fond blanc -->
    <solid android:color="#FFFFFF" />

    <!-- Bordure rouge douce -->
    <stroke
        android:width="1dp"
        android:color="#8B0000" /> <!-- rouge foncé -->

    <!-- Coins arrondis -->
    <corners android:radius="12dp" />

    <!-- Légère ombre / padding simulé -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
</shape>
