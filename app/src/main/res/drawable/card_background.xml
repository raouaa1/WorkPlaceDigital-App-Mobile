<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fond blanc -->
    <solid android:color="#FFFFFF"/>

    <!-- Bord arrondi -->
    <corners android:radius="12dp" />

    <!-- Ombre interne légère simulée par un contour (stroke) -->
    <stroke
        android:width="1dp"
        android:color="#33000000" />

    <!-- Ombre portée (fonctionne sur certains Android récents) -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />

</shape>
