<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bubble_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#dbc8c8">

    <!-- Bulles d'arrière-plan -->
    <View
        android:id="@+id/bubble_1"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/bubble_1"
        android:layout_marginTop="40dp"
        android:layout_marginStart="60dp" />

    <View
        android:id="@+id/bubble_2"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/bubble_2"
        android:layout_marginTop="300dp"
        android:layout_marginStart="220dp" />

    <View
        android:id="@+id/bubble_3"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/bubble_3"
        android:layout_marginTop="550dp"
        android:layout_marginStart="30dp" />

    <View
        android:id="@+id/bubble_4"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bubble_4"
        android:layout_marginTop="80dp"
        android:layout_marginStart="300dp" />


    <!-- Bulle 5 -->
    <View
        android:id="@+id/bubble_5"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bubble_5"
        android:layout_marginTop="380dp"
        android:layout_marginStart="100dp" />

    <!-- Bulle 6 -->
    <View
        android:id="@+id/bubble_6"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bubble_6"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="30dp" />

    <!-- Formulaire Login au-dessus -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <LinearLayout
                android:id="@+id/login_container"
                android:layout_width="match_parent"
                android:layout_height="50px"
                android:layout_gravity="center_horizontal"
                android:layout_margin="24dp"
                android:background="@drawable/form_background"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center_horizontal"
                    android:maxWidth="400dp"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/logo"
                        android:layout_width="120dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/rounded_corners"
                        android:contentDescription="Logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logoooredoo" />

                    <TextView
                        android:id="@+id/login_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:text="Login"
                        android:textColor="#8B0000"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/input_background"
                        android:hint="Email"
                        android:importantForAutofill="yes"
                        android:inputType="textEmailAddress"
                        android:padding="12dp"
                        android:textColor="#333"
                        android:textSize="16sp" />

                    <!-- Champ mot de passe avec bouton afficher/masquer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/input_background"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/password"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Password"
                            android:inputType="textPassword"
                            android:padding="12dp"
                            android:textColor="#333"
                            android:textSize="16sp"
                            android:background="@android:color/transparent"/>

                        <ImageView
                            android:id="@+id/showPasswordBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:src="@drawable/ic_visibility_off"
                            android:contentDescription="Afficher/Masquer mot de passe"/>
                    </LinearLayout>


                    <Button
                        android:id="@+id/loginBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/button_background"
                        android:backgroundTint="#8B0000"
                        android:padding="12dp"
                        android:text="Login"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/goRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Don't have an account? Create one"
                        android:textColor="#000000"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/forgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Forgot password ?"
                        android:textColor="#8b0000"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginTop="10dp" />






                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
