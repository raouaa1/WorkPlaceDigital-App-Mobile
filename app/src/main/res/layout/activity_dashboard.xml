<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/nav_header_background"
            android:title="Dashboard"
            android:titleTextColor="@android:color/white" />

        <!-- Texte bienvenue -->
        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbar"
            android:text="Bienvenue sur WorkPlace Digital Mobile 🤳"
            android:textColor="@color/red"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="16dp" />

        <!-- ScrollView publications -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@id/welcomeText"
            android:layout_above="@id/bubblesLayout"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/editTextPublication"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Exprimez-vous..."
                    android:gravity="top"
                    android:background="@android:drawable/edit_text"
                    android:padding="8dp"
                    android:inputType="textMultiLine" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnUploadImage"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="🖼️ Photo"
                        android:background="@drawable/button_background"
                        android:backgroundTint="#F6ABAB" />

                    <Button
                        android:id="@+id/btnUploadVideo"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="📷 Vidéo"
                        android:background="@drawable/button_background"
                        android:backgroundTint="#F6ABAB" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPublish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Publier"
                    android:backgroundTint="#5BBDEF"
                    android:layout_marginTop="8dp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/textMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/holo_red_dark"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewPublications"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:paddingTop="12dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Bulles messages, notifications, chat et profil -->
        <LinearLayout
            android:id="@+id/bubblesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="4">

            <!-- Bulle Message -->
            <LinearLayout
                android:id="@+id/bubbleMessage"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/circle_white_border_red"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/messageIcon"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:contentDescription="Message"
                    android:src="@drawable/ic_chatbot" />

                <TextView
                    android:id="@+id/messageCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F69292"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:gravity="center" />
            </LinearLayout>


            <!-- Bulle Notification -->
            <LinearLayout
                android:id="@+id/bubbleNotification"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/circle_white_border_red"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/notificationIcon"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:contentDescription="Notification"
                    android:src="@drawable/ic_notification"
                    app:tint="#F69292" />

                <TextView
                    android:id="@+id/notificationCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F69292"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Bulle Chat -->
            <LinearLayout
                android:id="@+id/bubbleChat"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/circle_white_border_red"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/chatIcon"
                    android:layout_width="45dp"
                    android:layout_height="43dp"
                    android:contentDescription="Chat"
                    android:src="@drawable/ic_chat"
                    app:tint="#F69292" />

            </LinearLayout>

            <!-- Bulle Profil -->
            <LinearLayout
                android:id="@+id/bubbleProfile"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/circle_white_border_red"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/profileIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_profile"
                    app:tint="#F69292"
                    android:contentDescription="Profil" />

            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <!-- Drawer navigation -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@android:color/white"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@null" />

</androidx.drawerlayout.widget.DrawerLayout>
