<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenu principal du chat -->
    <LinearLayout
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#B80202"
            android:title="Chatbot"
            android:titleTextColor="#fff" />

        <!-- Bouton pour ouvrir la sidebar (déplacé ici, en haut) -->
        <Button
            android:id="@+id/btn_open_sidebar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🤖"
            android:visibility="visible"
            android:layout_gravity="end"
            android:background="@drawable/circle_white_border_red"
            android:textColor="#8B0000"
            android:textSize="24sp"
            android:layout_marginTop="8dp"
            android:padding="0dp"
            android:gravity="center" />

        <!-- RecyclerView pour afficher la conversation -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#fff" />

        <!-- Zone de saisie + bouton envoyer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Tape ton message..."
                android:backgroundTint="#F6ABAB"
                android:padding="8dp" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Envoyer"
                android:backgroundTint="#F6ABAB"
                android:textColor="#000"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Sidebar historique -->
    <LinearLayout
        android:id="@+id/sidebar_history"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#fff"
        android:padding="8dp"
        android:layout_gravity="start"
        android:elevation="10dp">

        <!-- Header sidebar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/sidebar_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🤖 Historique des chats"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_sidebar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×"
                android:textSize="24sp"
                android:background="?attr/selectableItemBackground"
                android:textColor="#8B0000" />
        </LinearLayout>

        <!-- Bouton nouveau chat -->
        <Button
            android:id="@+id/btn_new_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Nouveau Chat"
            android:background="#A52A2A"
            android:textColor="#fff"
            android:layout_marginBottom="8dp" />

        <!-- Liste historique (ListView) -->
        <ListView
            android:id="@+id/lv_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
