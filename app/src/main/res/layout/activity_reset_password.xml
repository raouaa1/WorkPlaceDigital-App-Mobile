<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="Réinitialiser le mot de passe"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Label pour nouveau mot de passe -->
        <TextView
            android:text="Nouveau mot de passe"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />



        <!-- Input nouveau mot de passe -->
        <EditText
            android:id="@+id/new_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez un nouveau mot de passe"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <!-- Label pour confirmation mot de passe -->
        <TextView
            android:text="Confirmer le mot de passe"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />



        <!-- Input confirmation mot de passe -->
        <EditText
            android:id="@+id/confirm_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirmez le mot de passe"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <Button
            android:id="@+id/reset_password_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Réinitialiser"
            android:layout_marginTop="24dp"
            android:backgroundTint="#8b0000"
            android:textColor="#ffffff" />

    </LinearLayout>
</ScrollView>
